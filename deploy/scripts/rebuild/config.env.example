# Copy to config.env and edit.
# config.env is gitignored — never commit credentials.
#
# After: `cp config.env.example config.env && edit config.env`

# Elasticsearch + Kibana endpoints
# Replace <gpu-server-ip> with your GPU server's IP address
ES_URL="https://<gpu-server-ip>:31920"
KB_URL="https://<gpu-server-ip>:31561"

# Elastic superuser credentials
ES_USER="elastic"
ES_PASSWORD=""  # set me — run: sudo kubectl get secret elasticsearch-es-elastic-user -o jsonpath='{.data.elastic}' | base64 -d

# MCP server endpoint — used for wiring the Agent Builder connector
# Replace <gpu-server-hostname> with your GPU node's hostname
MCP_URL="http://<gpu-server-hostname>:8888/mcp"

# curl flags: -k disables TLS verify (self-signed certs). Remove -k if you have a trusted CA.
CURL_FLAGS="-sk"
