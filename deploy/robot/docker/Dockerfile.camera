FROM ros:humble-ros-base

RUN apt-get update && apt-get install -y \
    python3-pip \
    libopencv-dev \
    python3-opencv \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install numpy

COPY src/camera/camera_node.py /ros2_ws/camera_node.py
COPY deploy/robot/docker/fastdds_no_shm.xml /ros2_ws/fastdds_no_shm.xml

RUN echo '#!/bin/bash\nsource /opt/ros/humble/setup.bash\nexec "$@"' > /entrypoint.sh \
    && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "-u", "/ros2_ws/camera_node.py"]
