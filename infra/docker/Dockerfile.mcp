FROM ros:jazzy-ros-base

RUN apt-get update && apt-get install -y \
    ros-jazzy-compressed-image-transport \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# OpenCV (no deps to avoid numpy conflict)
RUN pip3 install --break-system-packages --no-deps opencv-python-headless

# FastMCP server + uvicorn + APM
RUN pip3 install --break-system-packages --ignore-installed zipp \
    fastmcp uvicorn elastic-apm

COPY src/cortex/brain/mcp_server.py /ros2_ws/mcp_server.py

RUN echo '#!/bin/bash\nsource /opt/ros/jazzy/setup.bash\nexec "$@"' > /entrypoint.sh \
    && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "/ros2_ws/mcp_server.py"]

EXPOSE 8888
